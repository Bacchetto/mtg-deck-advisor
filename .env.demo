# The demo's settings: copy to .env (cp .env.demo .env) before `docker compose up`.
# Everything replays from recordings built into the image, so no API key,
# Ollama or GPU is needed, and nothing is paid for. See README.md for the steps.

# The Compose database, seeded from the demo dataset on first start.
POSTGRES_DB=mtg_deck_advisor
POSTGRES_USER=mtg
POSTGRES_PASSWORD=mtg

# Replay every model call (the agent, rules answers, reranking) and every
# query embedding from the demo session's recordings.
MODEL_PROVIDER=replay
REPLAY_DIR=recordings/demo

LOG_LEVEL=INFO
