# Copy to .env and fill in. Never commit .env.
# Every value here is read by mtg_deck_advisor.config.Settings; the variable
# name matches the setting name.

# Database (required). The local Docker Compose database. The host is
# 127.0.0.1, not localhost: localhost tries IPv6 (::1) first, and under
# Rancher Desktop a connection to ::1 hangs instead of being refused.
DATABASE_URL=postgresql://mtg:mtg@127.0.0.1:5432/mtg_deck_advisor

# Used by docker-compose.yml to create the database. Must match DATABASE_URL.
POSTGRES_DB=mtg_deck_advisor
POSTGRES_USER=mtg
POSTGRES_PASSWORD=mtg

# Logging. "console" is readable in a terminal; containers use "json".
LOG_LEVEL=INFO
LOG_FORMAT=console

# development | test | production
ENVIRONMENT=development

# Where the API listens. Keep 127.0.0.1 locally; the container uses 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8000
