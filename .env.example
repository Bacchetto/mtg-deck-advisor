# Copy to .env and fill in. Never commit .env.
# Every value here is read by mtg_deck_advisor.config.Settings; the variable
# name matches the setting name.

# Database (required). The local Docker Compose database. The host is
# 127.0.0.1, not localhost: localhost tries IPv6 (::1) first, and under
# Rancher Desktop a connection to ::1 hangs instead of being refused.
DATABASE_URL=postgresql://mtg:mtg@127.0.0.1:5432/mtg_deck_advisor

# Used by docker-compose.yml to create the database. Must match DATABASE_URL.
POSTGRES_DB=mtg_deck_advisor
POSTGRES_USER=mtg
POSTGRES_PASSWORD=mtg

# Logging. "console" is readable in a terminal; containers use "json".
LOG_LEVEL=INFO
LOG_FORMAT=console

# development | test | production
ENVIRONMENT=development

# Where the API listens. Keep 127.0.0.1 locally; the container uses 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8000

# Ingestion. Downloaded source files are cached here (git-ignored).
CACHE_DIR=data/cache
# Scryfall asks every client to identify itself; the default names this project.
# SCRYFALL_USER_AGENT=mtg-deck-advisor/0.1 (+https://github.com/Bacchetto/mtg-deck-advisor)
# The Comprehensive Rules edition to ingest, pinned so a new edition is a
# deliberate change. Current file: linked from https://magic.wizards.com/en/rules
# RULES_URL=https://media.wizards.com/2026/downloads/MagicCompRules%2020260925.txt

# Model calls. MODEL_PROVIDER is anthropic, ollama or replay; switching it is
# a configuration change only.
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-opus-5-5
MODEL_TIMEOUT_SECONDS=60
# The most one run may spend on model calls, in US dollars.
RUN_COST_CAP_USD=1.0
# Your Anthropic API key (Claude Console). Keep it only in .env, never committed.
# Also set a monthly spend limit in the Console.
ANTHROPIC_API_KEY=

# The local model server (Ollama for Windows, using the GPU). From Docker
# containers this is http://host.docker.internal:11434 (set in Compose).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CHAT_MODEL=qwen3:14b
EMBEDDING_MODEL=qwen3-embedding:0.6b
