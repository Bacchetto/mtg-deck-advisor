# Copy to .env and fill in. Never commit .env.
# Every value here is read by mtg_deck_advisor.config.Settings; the variable
# name matches the setting name.

# Database (required). The local Docker Compose database, once it exists.
DATABASE_URL=postgresql://mtg:mtg@localhost:5432/mtg_deck_advisor

# Logging. "console" is readable in a terminal; containers use "json".
LOG_LEVEL=INFO
LOG_FORMAT=console

# development | test | production
ENVIRONMENT=development
