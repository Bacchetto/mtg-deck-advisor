# --- Secrets (SEC-1) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json
service-account*.json

# --- Personal notes (deliberately untracked) ---
INTERVIEW-NOTES.md
WORKING-AGREEMENT.md

# --- Personal Claude Code settings (e.g. enabling the project MCP server) ---
.claude/settings.local.json

# --- Python ---
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Tooling caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
pytest-cache-files-*/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Local data, API caches, model files ---
data/*
!data/.gitkeep
.cache/
*.sqlite
*.sqlite3
*.db
*.gguf
*.safetensors

# --- Logs / traces ---
logs/
*.log

# --- Docker / infra ---
docker-compose.override.yml
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Eval runs ---
# The free retrieval runs are regenerated at will, so only their reports are
# committed. Paid suites' runs (rules_qa, deck tasks...) are committed: they
# hold the answers that hand checks and rescoring use, which would cost money
# to produce again.
evals/runs/dev/
